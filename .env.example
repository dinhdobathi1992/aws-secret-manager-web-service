# Copy to .env and fill in. Never commit .env.
# Do not quote values: `docker run --env-file` keeps quotes as literal characters.
# Avoid `$` in values: docker compose expands it (write `$$` there), `docker run` does not.

# Public base URL of the app (OIDC redirect URI is ${APP_URL}/api/auth/callback). Runtime only.
APP_URL=http://localhost:3000

# Cookie sealing key, at least 32 characters. Generate: openssl rand -hex 32
SESSION_SECRET=

# Entra ID app registration (see docs/entra-setup.md)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# One entry per AWS account. roleArn is required: the app always calls sts:AssumeRole.
# groups are Entra group object ids; a user's role in an account is the highest group they belong to.
ACCOUNTS=[{"id":"dev","name":"Development","region":"ap-southeast-1","roleArn":"arn:aws:iam::123456789012:role/secrets-console","groups":{"reader":"00000000-0000-0000-0000-000000000001","writer":"00000000-0000-0000-0000-000000000002","admin":"00000000-0000-0000-0000-000000000003"}}]

# Optional
LOG_LEVEL=info
APP_NAME=Secrets Console
# APP_LOGO_URL=/logo.svg

# Local base identity before AssumeRole (the default AWS credential chain is used)
# AWS_PROFILE=my-sso-profile
